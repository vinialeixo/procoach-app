# Banco de dados PostgreSQL + pgvector
POSTGRES_USER=procoach
POSTGRES_PASSWORD=procoach
POSTGRES_DB=procoach

# Segurança JWT (OBRIGATÓRIO trocar em produção — mínimo 32 bytes para HS256)
PROCOACH_JWT_SECRET=procoach-dev-jwt-secret-change-me-32bytes!
PROCOACH_MFA_ENABLED=false

# E-mail (no compose de piloto, apontado para o Mailpit em http://localhost:8025)
PROCOACH_EMAIL_ENABLED=true
PROCOACH_EMAIL_FROM=no-reply@procoach.local

# Push notifications (none | log | fcm)
PROCOACH_PUSH_PROVIDER=none

# Porta exposta do Frontend SPA (container Nginx roda na 8080)
FRONTEND_PORT=5173
